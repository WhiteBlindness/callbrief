    {
      "source_id": "eu_funding_tenders",
      "name": "EU Funding & Tenders Portal",
      "authority": "European Commission",
      "jurisdiction": "direct_eu",
      "official": true,
      "base_url": "https://api.tech.ec.europa.eu/search-api/prod/rest/search",
      "discovery_method": "api",
      "content_types": ["application/json"],
      "opportunity_types": ["grant", "tender", "public_programme"],
      "check_cadence": "weekly",
      "enabled": true,
      "priority": 1,
      "status": "active",
      "legal_notes": "A documentação oficial descreve a API de pesquisa pública para integração. Conservar URL e atribuição. O aviso legal geral prevê CC BY 4.0 para conteúdos da UE neste sítio Web, salvo indicação em contrário; confirmar se se aplica aos dados da API e verificar direitos de terceiros e avisos específicos. A documentação consultada não publica limites de pedidos; manter cadência semanal.",
      "adapter": "funding_tenders",
      "legal_status": "terms_need_confirmation",
      "commercial_redistribution": false,
      "source_family": "eu_direct_funding",
      "source_role": "canonical",
      "canonical_source": "eu_funding_tenders",
      "authority_relationship": "canonical_programme_record",
      "snapshot_policy": "hash_and_excerpt",
      "last_verified": "2026-10-06"
    },
    {
      "source_id": "ted_eu_procurement",
      "name": "TED avisos de contratação pública",
      "authority": "Serviço das Publicações da União Europeia",
